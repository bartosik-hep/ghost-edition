{{#split feed_tags as |tag_names|}}
{{#foreach tag_names as |tag_name|}}
    {{#get "tags"}}
    {{#foreach tags}}
        {{#match slug tag_name}}
        <section class="topic">
            <header class="topic-header">
                <h2 class="topic-name">
                    {{name}}
                </h2>
            </header>
            {{#get "posts" order="published_at asc" filter="tag:{{slug}}" limit="4" as |featured|}}
                <ul class="topic-article-feed">
                    {{#foreach featured}}
                    {{#match @number "<" 4}}
                    <li class="topic-article">
                        <h3 class="topic-article-title">
                            {{#match featured}}
                            <a class="topic-article-link" href="{{url}}">
                                {{> "icons/chevron-right"}} {{title}}
                            </a>
                            {{else}}
                                {{> "icons/chevron-right"}} {{title}}
                            {{/match}}
                        </h3>
                    </li>
                    {{else}}
                    <a class="topic-more" href="{{url}}">Show more →</a>
                    {{/match}}
                    {{/foreach}}
                </ul>
            {{/get}}
        </section>
        {{/match}}
    {{/foreach}}
{{/get}}
{{/foreach}}
{{/split}}